    <PublishSingleFile>true</PublishSingleFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NexaShareControl.Native</AssemblyName>
    <Version>1.1.0</Version>
  </PropertyGroup>
</Project>
